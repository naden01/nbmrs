# Token from @BotFather
BOT_TOKEN=123456:ABC-your-token
# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot)
ALLOWED_USER_IDS=123456789

# Optional alert thresholds (%)
ALERT_CPU=90
ALERT_MEM=90
ALERT_DISK=90
# Check every N seconds / re-alert after N seconds
ALERT_INTERVAL=60
ALERT_COOLDOWN=1800
